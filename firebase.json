{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "workboard-cocina",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      ".git/**",
      "**/*.md",
      "**/*.xls",
      "**/*.xlsx",
      "**/*.xlsm",
      "**/*Prototype.html",
      "**/tests/**",
      "functions/**",
      "usuarios.md"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
